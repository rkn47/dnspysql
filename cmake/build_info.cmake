# Writes build_info.hpp with the commit the binary is built from (git describe), run on every build so a binary
# built after a commit names that commit. The file is rewritten only when the text changes, so nothing rebuilds
# otherwise. Without git (a source archive) the commit is "unknown".
# Inputs: -DSRC=<source dir> -DOUT=<header path>
execute_process(COMMAND git -C "${SRC}" describe --always --dirty --abbrev=10 --exclude=*
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
  set(commit "unknown")
endif()
set(text "// generated by cmake/build_info.cmake\n#pragma once\n#define DNSPYSQL_COMMIT \"${commit}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
