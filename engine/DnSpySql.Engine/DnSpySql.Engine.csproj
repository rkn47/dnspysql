<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Loaded as a component by the native host: emits runtimeconfig.json + deps.json -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>DnSpySql</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The workflow guides (dnspysql_guides table, MCP prompts): DnSpySql.Guides.<topic>.md -->
    <EmbeddedResource Include="Guides/*.md" LogicalName="DnSpySql.Guides.%(Filename).md" />
    <!-- Data the tables label with (capabilities): DnSpySql.Rules.<name>.json -->
    <EmbeddedResource Include="Rules/*.json" LogicalName="DnSpySql.Rules.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <!-- Roslyn brings its own analyzers (Microsoft.CodeAnalysis.Analyzers: rules for code that extends the compiler). Those
       of Roslyn 5 need a newer compiler than the .NET 8 SDK's (CS9057) and check nothing the engine does with Roslyn. -->
  <Target Name="DropRoslynAnalyzers" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.CodeAnalysis.Analyzers'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- dnSpyEx's dnlib-backed decompiler, vendored under engine/vendor. It
         replaces the upstream ICSharpCode.Decompiler NuGet package: that one
         reads System.Reflection.Metadata, which means parsing every assembly a
         second time and re-serializing the dnlib model after each edit. -->
    <ProjectReference Include="../vendor/ILSpyCore/DnSpySql.Vendor.ILSpyCore.csproj" />
    <!-- dnSpy's BAML -> XAML decompiler (baml table, export_project). -->
    <ProjectReference Include="../vendor/BamlDecompiler/DnSpySql.Vendor.BamlDecompiler.csproj" />
  </ItemGroup>

</Project>
