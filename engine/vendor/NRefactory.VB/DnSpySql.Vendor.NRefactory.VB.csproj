<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored dnSpyEx source, compiled for net8.0. See engine/vendor/README.md.
    dnSpyEx is GPL-3.0-or-later; the submodule is used unmodified (THIRD_PARTY_NOTICES.md).

    ICSharpCode.NRefactory.VB: the VB.NET syntax tree and output visitor that dnSpy's VB decompiler converts the C#
    tree into. It lives in the ILSpy fork's submodule (ICSharpCode.Decompiler/NRefactory.VB), not in NRefactory's.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ICSharpCode.NRefactory.VB</AssemblyName>
    <RootNamespace>ICSharpCode.NRefactory.VB</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SignAssembly>false</SignAssembly>
    <!-- Vendored third-party code: its warnings are not ours to fix. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);CS8632;CS1685;CS0618;CS0612;CS0067;CS0169;CS0414;CS0649;CS1591;CS0108;CS0109;CS0162;CS0164;CS0219;CS0252;CS0253;CS0282;CS1998;CS8509;SYSLIB0011;SYSLIB0050;SYSLIB0051;NU1701</NoWarn>
    <DnSpyEx>$(MSBuildThisFileDirectory)../../../external/dnSpyEx</DnSpyEx>
    <IlSpyFork>$(DnSpyEx)/Extensions/ILSpy.Decompiler</IlSpyFork>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(IlSpyFork)/ICSharpCode.Decompiler/NRefactory.VB/ICSharpCode.NRefactory.VB/**/*.cs" />
  </ItemGroup>

  <!-- The upstream project's references (ICSharpCode.NRefactory.VB.csproj). -->
  <ItemGroup>
    <ProjectReference Include="../ContractsLogic/DnSpySql.Vendor.ContractsLogic.csproj" />
    <ProjectReference Include="../NRefactory/DnSpySql.Vendor.NRefactory.csproj" />
    <ProjectReference Include="../NRefactory.CSharp/DnSpySql.Vendor.NRefactory.CSharp.csproj" />
    <ProjectReference Include="../Decompiler/DnSpySql.Vendor.Decompiler.csproj" />
  </ItemGroup>

</Project>
